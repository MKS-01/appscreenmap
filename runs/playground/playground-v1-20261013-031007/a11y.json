   "sc": "1.1.1",
   "name": "Non-text Content",
   "level": "A",
   "kind": "review",
   "severity": "info",
   "why": "A sizeable image has no text alternative. Fine if decorative; otherwise it needs one.",
   "fix": "Set contentDescription for meaningful images, and null / importantForAccessibility=no for decorative ones.",
   "native_note": ""
  }
